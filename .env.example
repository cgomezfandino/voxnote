# Voxnote — Configuration
# Copy to .env and adjust values as needed.

# =============================================================================
# LLM Provider Selection
# =============================================================================
# Choose: ollama | openai | kimi | glm | google
VOXNOTE_LLM_PROVIDER=ollama

# =============================================================================
# Whisper Configuration
# =============================================================================
# Whisper model: tiny|base|small|medium|turbo|large-v3
VOXNOTE_WHISPER_MODEL=turbo

# Audio language (ISO 639-1). Leave empty for auto-detect.
VOXNOTE_LANGUAGE=es

# =============================================================================
# Ollama Configuration (when LLM_PROVIDER=ollama)
# =============================================================================
VOXNOTE_OLLAMA_MODEL=llama3.1:8b
VOXNOTE_OLLAMA_URL=http://localhost:11434
VOXNOTE_OLLAMA_TIMEOUT=120

# =============================================================================
# OpenAI Configuration (when LLM_PROVIDER=openai)
# =============================================================================
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# =============================================================================
# Kimi/Moonshot Configuration (when LLM_PROVIDER=kimi)
# =============================================================================
# KIMI_API_KEY=sk-...
# KIMI_MODEL=moonshot-v1-8k

# =============================================================================
# GLM/Zhipu Configuration (when LLM_PROVIDER=glm)
# =============================================================================
# GLM_API_KEY=...
# GLM_MODEL=glm-4
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# For custom endpoint, use: GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4

# =============================================================================
# Google Gemini Configuration (when LLM_PROVIDER=google)
# =============================================================================
# GOOGLE_API_KEY=...
# GOOGLE_MODEL=gemini-2.0-flash-exp

# =============================================================================
# Speaker Diarization (requires whisperx: pip install -e ".[whisperx]")
# =============================================================================
# Enable speaker diarization (identifies who is speaking)
VOXNOTE_DIARIZE=false

# HuggingFace token for pyannote speaker diarization models
# Get one at: https://huggingface.co/settings/tokens
# Accept model terms at:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
VOXNOTE_HF_TOKEN=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

# Min/max expected speakers in the meeting
VOXNOTE_DIARIZE_MIN_SPEAKERS=2
VOXNOTE_DIARIZE_MAX_SPEAKERS=5

# Compute type for whisperX (int8 for CPU/macOS, float16 for CUDA GPU)
VOXNOTE_COMPUTE_TYPE=int8

# =============================================================================
# Output Configuration
# =============================================================================
VOXNOTE_OUTPUT_DIR=output
VOXNOTE_SAMPLE_RATE=16000
